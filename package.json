{
  "name": "skuuill-profile-and-landing",
  "version": "1.0.0",
  "private": true,
  "description": "Perfil de GitHub y portafolio web de Spulp",
  "scripts": {
    "lint": "markdownlint-cli2 && astro check",
    "test": "playwright test",
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4179",
    "serve:test": "npm run build && npm run preview",
    "check": "astro check",
    "format": "prettier --plugin prettier-plugin-astro --write src scripts tests astro.config.mjs",
    "branding": "node scripts/build-branding.mjs",
    "review:visual": "node scripts/review-portfolio.mjs",
    "check:privacy": "node scripts/check-privacy.mjs"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.11",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/three": "0.186.0",
    "lighthouse": "13.5.0",
    "markdownlint-cli2": "0.23.3",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "sharp": "0.35.5"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "astro": "7.4.1",
    "gsap": "3.15.0",
    "three": "0.186.1",
    "typescript": "6.0.3"
  }
}
