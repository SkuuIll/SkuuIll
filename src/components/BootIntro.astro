---
import { asset } from "../data/projects";
---

<dialog id="boot-intro" class="boot-intro" aria-label="Presentación de Skull">
  <img
    src={asset("media/skull-signal-poster.webp")}
    alt=""
    width="1280"
    height="800"
    loading="lazy"
  />
  <div class="boot-inner shell">
    <span class="mono">SKULL / DIGITAL EXPERIENCE</span>
    <p class="boot-word" aria-hidden="true">
      SKULL<span>_</span>
    </p>
    <div class="boot-bottom">
      <p class="mono">DISEÑO · CÓDIGO · INTERACCIÓN</p>
      <button id="skip-intro" type="button" autofocus>
        Entrar al portafolio ↗
      </button>
    </div>
  </div>
</dialog>
