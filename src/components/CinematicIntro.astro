---
import { asset } from "../data/projects";
import BootIntro from "./BootIntro.astro";
---

<BootIntro />
<section id="inicio" class="hero cinema-hero" aria-labelledby="hero-title">
  <div class="cinema-media" aria-hidden="true">
    <img
      src={asset("media/skull-signal-poster.webp")}
      width="1280"
      height="800"
      alt=""
      fetchpriority="high"
    />
    <video
      class="cinema-film"
      data-src={asset("media/skull-signal.webm")}
      muted
      loop
      playsinline
      preload="none"
      tabindex="-1"
    ></video>
  </div>
  <div class="cinema-shade" aria-hidden="true"></div>
  <div class="cinema-content shell">
    <div class="cinema-kicker mono">
      <span>SKULL / DESARROLLO DE SOFTWARE</span>
      <div class="cinema-preferences" hidden>
        <span class="cinema-status" aria-live="polite">
          Movimiento activo
        </span>
        <button type="button" id="cinema-toggle" aria-pressed="false">
          Pausar experiencia
        </button>
        <button type="button" id="film-play" hidden>
          Reproducir fondo
        </button>
      </div>
    </div>
    <div class="cinema-copy">
      <p class="eyebrow">INDEPENDENT SOFTWARE DEVELOPER / ARGENTINA</p>
      <h1 id="hero-title">
        <span data-hero-line>
          SKULL<span class="cinema-dot">.</span>
        </span>
      </h1>
      <p class="cyber-manifesto" data-hero-line>
        Código. Carácter. Futuro.
      </p>
      <p class="cinema-description">
        Soy Skull. Diseño y desarrollo productos digitales que conectan
        personas, procesos y plataformas.
      </p>
      <a href="#trabajo" class="cinema-cta">
        Explorá mi trabajo <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="cinema-bottom">
      <a class="cinema-scroll" href="#trabajo">
        <span aria-hidden="true">↓</span> DESLIZÁ PARA EXPLORAR
      </a>
      <span class="cinema-credit mono">
        SKULL SIGNAL / ARTE DIGITAL EN MOVIMIENTO
      </span>
    </div>
  </div>
  <div class="cinema-coordinate" aria-hidden="true">
    DISEÑO / CÓDIGO / INTERACCIÓN
  </div>
</section>
