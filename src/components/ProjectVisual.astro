---
import { asset, type Project } from "../data/projects";
interface Props {
  project: Project;
  hero?: boolean;
}
const { project, hero = false } = Astro.props;
---

<div
  class:list={[
    "project-visual",
    `tone-${project.tone}`,
    { "project-visual-hero": hero },
  ]}
  style={`--project-name: '${project.id}'`}
>
  {project.image ? (
    <img
      src={asset(`media/${project.image}`)}
      alt={project.alt}
      width={project.id === "cpaul" ? 1122 : 1440}
      height={project.id === "cpaul" ? 1402 : 1000}
      loading={hero ? "eager" : "lazy"}
      decoding="async"
      fetchpriority={hero ? "high" : "auto"}
      data-parallax
    />
  ) : project.id === "repo-setup" ? (
    <div
      class="terminal-visual"
      aria-label="Repo Setup Kit, herramienta de línea de comandos para Windows y Linux"
    >
      <div class="terminal-top">
        <span></span>
        <span></span>
        <span></span>
        <p>repo-setup / terminal</p>
      </div>
      <div class="terminal-content">
        <span class="terminal-comment"># Menos preparación. Más proyecto.</span>
        <p>
          <span class="prompt">→</span> repo-setup . --full
        </p>
        <hr />
        <p class="terminal-brand">
          Repo
          <br />
          Setup Kit<span>_</span>
        </p>
        <span class="terminal-comment">Python / PowerShell / Shell</span>
      </div>
      <p class="terminal-foot">
        WINDOWS + LINUX <span>CLI TOOL</span>
      </p>
    </div>
  ) : project.id === "fluxnet" ? (
    <div class="fluxnet-product">
      <img
        src={asset("media/fluxnet-android-4.9.6.png")}
        alt="Interfaz Android de FluxNet 4.9.6: inicio en modo Lite, sin perfil ni servidor activo."
        width="1080"
        height="2400"
        loading={hero ? "eager" : "lazy"}
        decoding="async"
      />
      <span>ANDROID · CAPTURA ARCHIVADA 4.9.6</span>
    </div>
  ) : (
    <div class="type-visual">
      <span>{project.label}</span>
      <strong>{project.title}</strong>
      <p>{project.stack.slice(0, 3).join(" / ")}</p>
      <span class="visual-tag">Identidad del proyecto</span>
    </div>
  )}
</div>

<style>
  .fluxnet-product {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    padding: 2rem;
    background: #dce7e8;
  }
  .fluxnet-product img {
    display: block;
    height: 100%;
    width: auto;
    max-width: 76%;
    object-fit: contain;
    border-radius: 1rem;
    box-shadow: 0 1rem 2rem #142b3433;
  }
  .fluxnet-product span {
    writing-mode: vertical-rl;
    font: 0.65rem var(--font-mono, monospace);
    letter-spacing: 0.08em;
    color: #243c43;
  }
</style>
