---
import "@fontsource-variable/manrope";
import "@fontsource-variable/geist-mono";
import manropeLatin from "@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url";
import geistLatin from "@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url";
import "../styles/global.css";
import "../styles/experience.css";

import "../styles/shell.css";
import "../styles/landing.css";
import { asset } from "../data/projects";
import { profile } from "../data/profile";
interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Spulp — Diseño, código e interacción",
  description = profile.summary,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, "https://skuuill.github.io");
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="preload"
      href={manropeLatin}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={geistLatin}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#080d13" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={asset("favicon.svg")} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:url" content={canonical} />
    <meta
      property="og:image"
      content="https://skuuill.github.io/SkuuIll/media/social-cover.png"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      let theme = "dark";
      try {
        const savedTheme = localStorage.getItem("skull-theme");
        if (["light", "dark"].includes(savedTheme)) theme = savedTheme;
      } catch {}
      document.documentElement.dataset.theme = theme;
      try {
        if (sessionStorage.getItem("skull-motion") === "paused")
          document.documentElement.dataset.motion = "paused";
        const mode = localStorage.getItem("spulp-motion-mode");
        document.documentElement.dataset.motionMode = [
          "auto",
          "full",
          "reduced",
        ].includes(mode)
          ? mode
          : "auto";
        const palette = sessionStorage.getItem("skull-palette");
        document.documentElement.dataset.palette = [
          "forest",
          "blue",
          "clay",
        ].includes(palette)
          ? palette
          : "forest";
      } catch {}
    </script>
  </head>
  <body>
    <div class="reading-progress" aria-hidden="true"></div>
    <a class="skip-link" href="#contenido">
      Saltar al contenido
    </a>
    <header class="site-header shell">
      <a class="brand" href={asset("")} aria-label="Spulp, inicio">
        <svg viewBox="0 0 32 32" fill="none" aria-hidden="true">
          <path
            d="M24 6H11L5 13l21 6-6 7H7"
            stroke="currentColor"
            stroke-width="4"
            stroke-linecap="square"
          />
          <path d="M20 2v8M16 6h8" stroke="currentColor" stroke-width="2" />
        </svg>
        <span>
          Spulp<span class="brand-period">.</span>
        </span>
      </a>
      <nav class="desktop-nav" aria-label="Navegación principal">
        <a href={asset("#laboratorio")}>Laboratorio</a>
        <a href={asset("#secuencia")}>Experiencia</a>
        <a href={asset("#proceso")}>Proceso</a>
      </nav>
      <button
        id="chapters-toggle"
        class="chapters-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-nav"
        hidden
      >
        Explorar <span aria-hidden="true">☰</span>
      </button>
      <button
        id="theme-toggle"
        class="theme-toggle"
        type="button"
        aria-label="Activar modo oscuro"
        aria-pressed="false"
        hidden
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="5" />
          <path d="M12 1v3m0 16v3M1 12h3m16 0h3M4 4l2 2m12 12 2 2M4 20l2-2M18 6l2-2" />
        </svg>
        <span>Oscuro</span>
      </button>
      <a class="header-contact" href={asset("#contacto")}>
        Conversemos <span aria-hidden="true">↗</span>
      </a>
      <button
        class="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Abrir menú"
        hidden
      >
        <span></span>
        <span></span>
      </button>
      <dialog
        id="mobile-nav"
        class="mobile-nav chapter-menu"
        aria-label="Explorar capítulos"
        hidden
      >
        <div class="chapter-menu-content shell">
          <div class="chapter-menu-top mono">
            <span>SPULP / EXPLORAR</span>
            <button type="button" id="chapters-close">
              Cerrar menú <span aria-hidden="true">×</span>
            </button>
          </div>
          <nav aria-label="Navegación por capítulos">
            <a href={asset("")}>
              <span>00</span>Inicio
            </a>
            <a href={asset("#secuencia")}>
              <span>01</span>Experiencia
            </a>
            <a href={asset("#laboratorio")}>
              <span>02</span>Laboratorio
            </a>
            <a href={asset("#proceso")}>
              <span>03</span>Proceso
            </a>
            <a href={asset("proyectos/")} aria-label="Archivo de proyectos">
              <span>04</span>Archivo
            </a>
            <a href={asset("#contacto")}>
              <span>06</span>Contacto
            </a>
          </nav>
          <p class="mono chapter-menu-bottom">
            CÓDIGO CON IDENTIDAD. / ARGENTINA
          </p>
        </div>
      </dialog>
    </header>
    <main id="contenido">
      <slot />
    </main>
    <footer class="site-footer shell">
      <a class="footer-name" href={asset("")}>
        Spulp<span>↗</span>
      </a>
      <div>
        <p>Software desde Chaco, Argentina.</p>
        <p class="mono">© {new Date().getUTCFullYear()} / SkuuIll</p>
      </div>
      <div class="footer-links">
        <a href={profile.github}>GitHub ↗</a>
        <a href={`mailto:${profile.email}`}>Email ↗</a>
      </div>
      <div class="preferences" hidden>
        <button id="palette-toggle" type="button">
          Color: <span>Menta</span>
        </button>
        <button id="motion-toggle" type="button" aria-pressed="false">
          Pausar movimiento
        </button>
      </div>
    </footer>
    <script>
      import "../scripts/site";
    </script>
  </body>
</html>
