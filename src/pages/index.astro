---
import Layout from "../layouts/Layout.astro";
import SpatialExperience from "../components/SpatialExperience.astro";
import Contact from "../components/Contact.astro";
import { asset, projects } from "../data/projects";
---

<Layout
  title="Skull — Diseño, código e interacción"
  description="Interfaces que responden. Un laboratorio de diseño, movimiento y desarrollo de software por Skull."
>
  <div
    class="signal-world"
    id="inicio"
    data-case-ids={projects.map((project) => project.id).join(" ")}
  >
    <svg class="glass-filter" width="0" height="0" aria-hidden="true">
      <defs>
        <filter
          id="glass-refraction"
          x="-20%"
          y="-20%"
          width="140%"
          height="140%"
          color-interpolation-filters="sRGB"
        >
          <feTurbulence
            type="fractalNoise"
            baseFrequency=".012 .018"
            numOctaves="2"
            seed="7"
            result="noise"
          />
          <feDisplacementMap
            in="SourceGraphic"
            in2="noise"
            scale="16"
            xChannelSelector="R"
            yChannelSelector="G"
          />
        </filter>
      </defs>
    </svg>
    <div class="signal-backdrop" aria-hidden="true">
      <div class="signal-stage">
        <svg class="signal-fallback" viewBox="0 0 800 800" fill="none">
          <defs>
            <pattern
              id="signal-grid"
              width="50"
              height="50"
              patternUnits="userSpaceOnUse"
            >
              <path d="M50 0H0V50" stroke="currentColor" stroke-opacity=".14" />
            </pattern>
          </defs>
          <rect width="800" height="800" fill="url(#signal-grid)" />
          {Array.from({ length: 14 }, (_, i) => (
            <ellipse
              cx="400"
              cy="400"
              rx={100 + i * 15}
              ry={250 - i * 11}
              transform={`rotate(${i * 13} 400 400)`}
              stroke="currentColor"
              stroke-opacity=".4"
            />
          ))}
          <circle
            cx="400"
            cy="400"
            r="300"
            stroke="currentColor"
            stroke-dasharray="2 16"
          />
        </svg>
        <canvas id="signal-canvas"></canvas>
        <div class="glass-lens">
          <svg viewBox="0 0 32 32" fill="none">
            <path
              d="M24 6H11L5 13l21 6-6 7H7"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
            />
          </svg>
        </div>
        <span class="signal-coordinate mono">
          SP / FIELD_001
          <br />
          PROCEDURAL SIGNAL
        </span>
      </div>
    </div>
    <section class="sp-hero shell" aria-labelledby="hero-title">
      <div class="hero-topline mono">
        <span>
          <i class="status-dot"></i> SKULL / DIGITAL LAB
        </span>
        <span>DISEÑO + DESARROLLO</span>
      </div>
      <div class="sp-hero-copy">
        <p class="eyebrow">IDEAS QUE TOMAN FORMA</p>
        <h1 id="hero-title">
          Diseño interfaces
          <br />
          que <em>responden.</em>
        </h1>
        <p class="sp-lead">
          Código, movimiento y un poco de curiosidad.
          <br />
          Explorá lo que pasa cuando trabajan juntos.
        </p>
        <div class="sp-actions">
          <a class="sp-primary" href="#laboratorio" data-magnetic>
            Explorar la experiencia <span aria-hidden="true">↘</span>
          </a>
          <a class="sp-secondary" href="#contacto">
            Hablemos <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
      <div class="hero-signature">
        <span>
          Skull<span class="signature-dot">.</span>
        </span>
        <div class="mono">
          INDEPENDIENTE
          <br />
          ARGENTINA · DESDE 2022
        </div>
      </div>
      <a class="sp-scroll mono" href="#secuencia">
        <span aria-hidden="true">↓</span> DESLIZÁ PARA TRANSFORMAR
      </a>
    </section>
    <section
      class="sp-sequence shell"
      id="secuencia"
      aria-labelledby="sequence-title"
    >
      <div class="sequence-heading">
        <p class="eyebrow">01 / UN SISTEMA, MUCHAS FORMAS</p>
        <h2 id="sequence-title">
          Cada gesto.
          <br />
          <span>Una respuesta.</span>
        </h2>
      </div>
      <div class="sequence-steps">
        <article data-phase="0">
          <span class="mono">01 — ESTRUCTURA</span>
          <h3>Primero, el orden.</h3>
          <p>
            Retículas, proporciones y espacio. La base de una interfaz que se
            entiende.
          </p>
        </article>
        <article data-phase="1">
          <span class="mono">02 — MOVIMIENTO</span>
          <h3>Después, el ritmo.</h3>
          <p>
            La forma se transforma con el scroll. El movimiento acompaña lo que
            querés contar.
          </p>
        </article>
        <article data-phase="2">
          <span class="mono">03 — CONEXIÓN</span>
          <h3>Todo responde.</h3>
          <p>
            Una interacción coherente conecta el diseño, el código y a quien
            está del otro lado.
          </p>
        </article>
      </div>
    </section>
  </div>
  <SpatialExperience />
  <section class="sp-lab shell" id="laboratorio" aria-labelledby="lab-title">
    <div class="lab-heading">
      <div>
        <p class="eyebrow">02 / TOCÁ, CAMBIÁ, EXPLORÁ</p>
        <h2 id="lab-title">
          Menos promesas.
          <br />
          <span>Más interacción.</span>
        </h2>
      </div>
      <p>
        Este es un pequeño laboratorio de interfaces. Tres experimentos
        originales para probar el diseño en acción.
      </p>
    </div>
    <div class="lab-console">
      <div class="lab-tabs" hidden role="tablist" aria-label="Experimentos">
        <button
          role="tab"
          id="tab-composition"
          aria-controls="panel-composition"
          aria-selected="true"
          tabindex="0"
        >
          01 Composición
        </button>
        <button
          role="tab"
          id="tab-motion"
          aria-controls="panel-motion"
          aria-selected="false"
          tabindex="-1"
        >
          02 Movimiento
        </button>
        <button
          role="tab"
          id="tab-interface"
          aria-controls="panel-interface"
          aria-selected="false"
          tabindex="-1"
        >
          03 Interfaces
        </button>
      </div>
      <div
        class="lab-panel"
        role="tabpanel"
        id="panel-composition"
        aria-labelledby="tab-composition"
        tabindex="0"
      >
        <div class="experiment-copy">
          <span class="mono">EXPERIMENTO_01 / GEOMETRÍA</span>
          <h3>
            El orden también
            <br />
            se puede jugar.
          </h3>
          <p>
            Modificá la densidad y la distribución. Una misma regla, cientos de
            composiciones.
          </p>
          <div class="lab-controls" hidden>
            <label for="density">
              Densidad <output id="density-value">8</output>
            </label>
            <input id="density" type="range" min="4" max="12" value="8" />
            <button type="button" id="layout-shuffle" class="sp-secondary">
              Cambiar distribución ↗
            </button>
          </div>
        </div>
        <div class="composition-art" aria-hidden="true">
          {Array.from({ length: 64 }, (_, i) => (
            <span style={`--i:${i};--r:${Math.floor(i / 8)};--c:${i % 8}`} />
          ))}
        </div>
      </div>
      <div
        class="lab-panel"
        role="tabpanel"
        id="panel-motion"
        aria-labelledby="tab-motion"
        tabindex="0"
      >
        <div class="experiment-copy">
          <span class="mono">EXPERIMENTO_02 / FRECUENCIA</span>
          <h3>
            Encontrá
            <br />
            tu frecuencia.
          </h3>
          <p>
            Probá la amplitud de una onda. El pulso responde en tiempo real a
            cada cambio.
          </p>
          <div class="lab-controls" hidden>
            <label for="amplitude">
              Amplitud <output id="amplitude-value">50</output>
            </label>
            <input id="amplitude" type="range" min="10" max="90" value="50" />
          </div>
        </div>
        <div class="wave-art" aria-hidden="true">
          {Array.from({ length: 35 }, (_, i) => (
            <span
              style={`--i:${i};--height:${20 + Math.sin(i * 0.28) ** 2 * 70}%`}
            />
          ))}
          <span class="wave-axis mono">SIGNAL / SINE</span>
        </div>
      </div>
      <div
        class="lab-panel"
        role="tabpanel"
        id="panel-interface"
        aria-labelledby="tab-interface"
        tabindex="0"
      >
        <div class="experiment-copy">
          <span class="mono">EXPERIMENTO_03 / ESTADOS</span>
          <h3>
            Pequeños detalles.
            <br />
            Mejores respuestas.
          </h3>
          <p>
            Cambiá el estado de una interfaz y observá cómo se comunica. Una
            demostración visual, sin enviar datos.
          </p>
          <div class="lab-controls state-controls" hidden>
            <button type="button" data-demo-state="ready" aria-pressed="true">
              Listo
            </button>
            <button
              type="button"
              data-demo-state="working"
              aria-pressed="false"
            >
              Procesando
            </button>
            <button type="button" data-demo-state="done" aria-pressed="false">
              Completado
            </button>
          </div>
        </div>
        <div class="interface-art" data-state="ready">
          <div class="interface-top mono">
            <span>SP / INTERFACE</span>
            <span>DEMO</span>
          </div>
          <div class="interface-symbol" aria-hidden="true">
            ↗
          </div>
          <p id="interface-status" role="status">
            Todo listo para empezar.
          </p>
          <div class="interface-track" aria-hidden="true">
            <span></span>
          </div>
          <span class="mono interface-caption">
            UN ESTADO. UNA RESPUESTA CLARA.
          </span>
        </div>
      </div>
      <div class="lab-footer mono">
        <span>HECHO CON CÓDIGO / INTERACCIÓN REAL</span>
        <span>SKULL — LAB_2026</span>
      </div>
    </div>
    <noscript>
      <p class="lab-note">
        Podés recorrer las tres composiciones. Activá JavaScript para modificar
        sus controles.
      </p>
    </noscript>
  </section>
  <section
    class="sp-process shell"
    id="proceso"
    aria-labelledby="process-title"
  >
    <div class="process-heading">
      <p class="eyebrow">03 / DEL CONCEPTO A LA PANTALLA</p>
      <h2 id="process-title">
        La idea es el inicio.
        <br />
        <span>El detalle hace el resto.</span>
      </h2>
      <p>
        Diseño y desarrollo software independiente desde Argentina. Trabajo
        desde la interfaz hasta las APIs, los datos y la automatización.
      </p>
    </div>
    <div class="process-line" aria-hidden="true">
      <span></span>
    </div>
    <div class="process-steps">
      {[
        {
          n: "01",
          title: "Entender",
          text: "Definir el problema, las personas y el objetivo.",
        },
        {
          n: "02",
          title: "Dar forma",
          text: "Explorar la composición y probar la interacción.",
        },
        {
          n: "03",
          title: "Construir",
          text: "Conectar interfaces, lógica y datos.",
        },
        {
          n: "04",
          title: "Afinar",
          text: "Revisar accesibilidad, rendimiento y detalles.",
        },
      ].map((step) => (
        <article data-reveal>
          <span class="mono">{step.n}</span>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </article>
      ))}
    </div>
    <div class="archive-link">
      <p>¿Querés conocer trabajos anteriores?</p>
      <a href={asset("proyectos/")}>
        Explorá el archivo completo <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
  <Contact />
  <script>
    import "../scripts/landing";
  </script>
</Layout>
